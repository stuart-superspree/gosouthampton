        "access": {
          "en": "Level pavement, signal crossing with dropped kerbs.",
          "de": "Ebener Gehweg, Ampelübergang mit abgesenkten Bordsteinen."
        }
      },
      {
        "title": {
          "en": "Along Western Esplanade",
          "de": "Entlang der Western Esplanade"
        },
        "text": {
          "en": "Follow the walls north along Western Esplanade for 4 minutes. **Keep them on your right.**",
          "de": "Folgen Sie den Mauern 4 Minuten lang nach Norden entlang der Western Esplanade. **Halten Sie sie zu Ihrer Rechten.**"
        },
        "image": "/img/photos/walls-westquay.webp",
        "access": {
          "en": "Level pavement.",
          "de": "Ebener Gehweg."
        }
      },
      {
        "title": {
          "en": "Turn into WestQuay",
          "de": "Abbiegen zu WestQuay"
        },
        "text": {
          "en": "At WestQuay Esplanade, **turn right** into the city. The pedestrianised High Street is ahead.",
          "de": "An der WestQuay Esplanade **biegen Sie rechts ab** in die Stadt. Vor Ihnen liegt die Fußgängerzone High Street."
        },
        "image": "/img/photos/westquay-summer.webp",
        "access": {
          "en": "Level pavement.",
          "de": "Ebener Gehweg."
